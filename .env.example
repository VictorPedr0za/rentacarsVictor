# Copia este archivo como ".env" (en la raiz del proyecto) y completa tus datos.
# El archivo ".env" esta en .gitignore: NO se sube a GitHub.
#
# Solo hace falta para usar DynamoDB REAL en AWS. Con DynamoDB local no necesitas nada de esto.

# Credenciales de un usuario IAM con permiso sobre DynamoDB (ver GUIA_DYNAMODB.md, paso 4).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Region donde estan (o se crearan) las tablas. us-east-1 = N. Virginia.
AWS_REGION=us-east-1

# Prefijo de las tablas: rentacars_tiendas, rentacars_autos, ...
DYNAMODB_TABLE_PREFIX=rentacars_
